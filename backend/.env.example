# Copy this file to backend/.env (never commit .env). Restart the backend after editing.

# --- Featherless.ai (AI model provider) ---
# Paste your key from https://featherless.ai (Account -> API Keys). Leave empty to run the labeled deterministic demo mode.
FEATHERLESS_API_KEY=
# Qwen3-32B returns native tool calls on Featherless (verified). Change only if you want a different Featherless model.
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# auto = try native tool calls, fall back to a JSON tool protocol if the model rejects them. Or: native | json
LLM_TOOL_MODE=auto
LLM_TIMEOUT_S=45
RUN_TIME_BUDGET_S=90

# --- Storage and data ---
# DATABASE_URL=sqlite:///./property_cases.db
# SNAPSHOT_PATH=../sample_data/houston_snapshot.json
MAX_ROWS_PER_PROPERTY=1000
# Opening a property re-fetches it from the live Houston API when the cached copy is older than this.
LIVE_REFRESH_MINUTES=30

# Comma-separated frontend origins allowed to call the API directly (the Vite proxy needs none).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Accounts (Supabase profiles table, accessed only by this backend) ---
SUPABASE_URL=
# Supabase Dashboard -> Project Settings -> API Keys -> secret / service_role key. Server-only: never put it in frontend/.env.
SUPABASE_SERVICE_ROLE_KEY=
SESSION_DAYS=7

# Copy to frontend/.env. Only public values belong here: everything in this file is shipped to the browser.

# Supabase (optional): enables accounts and a synced portfolio. Use the project URL and the anon/publishable key,
# never the service-role key. Without these, users can continue as a local guest.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave unset to use the Vite /api proxy to the backend on 127.0.0.1:8000 (recommended for development).
# VITE_API_BASE=http://127.0.0.1:8000
